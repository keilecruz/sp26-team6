<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GlowUp</title>

    <!-- ✅ USE INDEX CSS -->
    <link rel="stylesheet" href="/index.css">

    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&display=swap"
        rel="stylesheet">
</head>

<body>

    <!-- ===== HEADER ===== -->
    <section class="topheader">
        <nav>
            <img src="../../photos/logo.png" alt="GlowUp logo" class="logo">

            <div class="nav-links">
                <a href="/login">Log in</a>
                <a href="/signup" class="nav-btn">Sign up</a>
            </div>
        </nav>
    </section>

    <!-- ===== HERO (KEEP YOUR BACKGROUND STYLE) ===== -->
    <section class="hero">

        <div class="text-box">
            <h1>GlowUp ✨</h1>
            <p>Beauty & Grooming Made Simple</p>

            <a href="/signup" class="btn">Get Started</a>
        </div>

    </section>

    <!-- ===== NEW BOTTOM SECTION ===== -->
    <section class="info-section">

        <div class="info-content">

            <!-- TEXT -->
            <div class="info-text">
                <h2>Find Your Perfect Beauty Match 💄</h2>
                <p>
                    GlowUp connects you with trusted beauty professionals for hair,
                    makeup, nails, and more. Book appointments easily and manage
                    everything in one place.
                </p>

                <ul>
                    <li>✔ Browse professionals</li>
                    <li>✔ Book appointments</li>
                    <li>✔ Leave reviews</li>
                </ul>
            </div>

            <!-- IMAGE -->
            <div class="info-image">
                <!-- ✅ YOUR SALON IMAGE -->
                <img src="/photos/salon.jpg" alt="Salon">
            </div>

        </div>

    </section>

</body>

</html>